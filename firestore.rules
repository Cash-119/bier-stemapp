rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function claimPath(s) { return /databases/$(db)/documents/claims/$(s); }
    // Geblokkeerde apparaten (mogen niks meer schrijven).
    function blocked() { return request.auth.uid in ['pFQSbtE8zSbFkgANLTO5j2Jv6fZ2']; }
    // Alleen deze namen mogen gekozen worden (test- is voor proefnamen, die zijn onzichtbaar).
    function allowedName(s) { return s in ['cas', 'hidde', 'lucas', 'shane', 'maurits', 'timo'] || s.matches('test-[a-z0-9-]+'); }
    function owns(s) {
      return request.auth != null && !blocked() && s is string && exists(claimPath(s))
        && get(claimPath(s)).data.uid == request.auth.uid;
    }
    function nameOf(s) { return get(claimPath(s)).data.name; }
    function strMax(v, n) { return v is string && v.size() <= n; }

    // Wie welke naam heeft. Elke naam kan maar één keer gekozen worden
    // en blijft daarna bij dat apparaat. Vrijgeven kan alleen via de Firebase-console.
    match /claims/{slug} {
      allow read: if true;
      allow create: if request.auth != null && !blocked() && allowedName(slug)
        && request.resource.data.keys().hasOnly(['name', 'uid', 'at'])
        && request.resource.data.uid == request.auth.uid
        && strMax(request.resource.data.name, 24);
      // Een naam die door een geblokkeerd apparaat is gekaapt, mag de echte persoon overnemen.
      allow update: if request.auth != null && !blocked()
        && resource.data.uid in ['pFQSbtE8zSbFkgANLTO5j2Jv6fZ2']
        && request.resource.data.keys().hasOnly(['name', 'uid', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == resource.data.name;
      allow delete: if false;
    }

    match /votes/{id} {
      allow read: if true;
      allow create, update: if owns(request.resource.data.slug)
        && id == request.resource.data.option + '__' + request.resource.data.slug
        && request.resource.data.name == nameOf(request.resource.data.slug)
        && request.resource.data.choice in ['ja', 'misschien', 'nee']
        && strMax(request.resource.data.note, 280);
      allow delete: if owns(resource.data.slug);
    }

    match /answers/{id} {
      allow read: if true;
      allow create, update: if owns(request.resource.data.slug)
        && id == request.resource.data.question + '__' + request.resource.data.slug
        && request.resource.data.name == nameOf(request.resource.data.slug)
        && strMax(request.resource.data.value, 200);
      allow delete: if owns(resource.data.slug);
    }

    match /options/{id} {
      allow read: if true;
      allow create: if owns(request.resource.data.bySlug)
        && request.resource.data.by == nameOf(request.resource.data.bySlug)
        && strMax(request.resource.data.title, 60);
      allow delete: if owns(resource.data.bySlug);
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function claimPath(s) { return /databases/$(db)/documents/claims/$(s); }
    function owns(s) {
      return request.auth != null && s is string && exists(claimPath(s))
        && get(claimPath(s)).data.uid == request.auth.uid;
    }
    function nameOf(s) { return get(claimPath(s)).data.name; }
    function strMax(v, n) { return v is string && v.size() <= n; }

    // Wie welke naam heeft. Een naam claimen kan maar één keer;
    // overnemen op een ander apparaat kan alleen met de juiste pincode.
    match /claims/{slug} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'uid', 'at'])
        && request.resource.data.uid == request.auth.uid
        && strMax(request.resource.data.name, 24)
        && getAfter(/databases/$(db)/documents/secrets/$(slug)).data.pin is string;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'uid', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == resource.data.name
        && get(/databases/$(db)/documents/logins/$(request.auth.uid)).data.slug == slug
        && get(/databases/$(db)/documents/logins/$(request.auth.uid)).data.pin
           == get(/databases/$(db)/documents/secrets/$(slug)).data.pin;
      allow delete: if false;
    }

    // Pincodes: door niemand te lezen, alleen door deze regels.
    match /secrets/{slug} {
      allow read, update, delete: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['pin'])
        && request.resource.data.pin is string
        && request.resource.data.pin.matches('[0-9]{4}')
        && getAfter(claimPath(slug)).data.uid == request.auth.uid;
    }

    // Inlogpoging op een nieuw apparaat.
    match /logins/{uid} {
      allow read: if false;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /votes/{id} {
      allow read: if true;
      allow create, update: if owns(request.resource.data.slug)
        && id == request.resource.data.option + '__' + request.resource.data.slug
        && request.resource.data.name == nameOf(request.resource.data.slug)
        && request.resource.data.choice in ['ja', 'misschien', 'nee']
        && strMax(request.resource.data.note, 280);
      allow delete: if owns(resource.data.slug);
    }

    match /answers/{id} {
      allow read: if true;
      allow create, update: if owns(request.resource.data.slug)
        && id == request.resource.data.question + '__' + request.resource.data.slug
        && request.resource.data.name == nameOf(request.resource.data.slug)
        && strMax(request.resource.data.value, 200);
      allow delete: if owns(resource.data.slug);
    }

    match /options/{id} {
      allow read: if true;
      allow create: if owns(request.resource.data.bySlug)
        && request.resource.data.by == nameOf(request.resource.data.bySlug)
        && strMax(request.resource.data.title, 60);
      allow delete: if owns(resource.data.bySlug);
    }
  }
}
